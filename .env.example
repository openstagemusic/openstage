# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored: never commit real keys.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend / email ---
# API key "openstage-vercel" for direct sends.
RESEND_API_KEY=
# Sender and reply-to used by transactional email.
EMAIL_FROM="OpenStage <noreply@getopenstage.it>"
EMAIL_REPLY_TO=ciao@getopenstage.it
# Optional: only for the 7B queue/webhook.
RESEND_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
EMAIL_WORKER_SECRET=
# Quota prudente della coda (non auth/transazionali dirette).
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
# Percentuale di quota riservata alle email transazionali.
EMAIL_RESERVE_PERCENT=20

# --- Admin ---
# Email that gets the admin role (must match `settings.admin_email` in the DB).
ADMIN_EMAIL=

# --- Site ---
# Local: http://localhost:3000 · Production: your Vercel domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: persistent Spotify player ---
# Only the playlist id (the part after /playlist/ in the Spotify URL).
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=

# --- Telegram alerts (server only) ---
# First bot: admin queues (tickets, claims, reports, drafts, failed emails).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Second bot: new registrations and new events.
TELEGRAM_ACTIVITY_BOT_TOKEN=
TELEGRAM_ACTIVITY_CHAT_ID=

# --- Optional: place search in the event editor ---
# Photon (komoot) is the default and needs no key. Set this only to point at a
# self-hosted Photon instance.
GEOCODER_URL=
