# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored: never commit real keys.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin ---
# Email that gets the admin role (must match `settings.admin_email` in the DB).
ADMIN_EMAIL=

# --- Site ---
# Local: http://localhost:3000 · Production: your Vercel domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: persistent Spotify player ---
# Only the playlist id (the part after /playlist/ in the Spotify URL).
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=

# --- Optional: place search in the event editor ---
# Photon (komoot) is the default and needs no key. Set this only to point at a
# self-hosted Photon instance.
GEOCODER_URL=
