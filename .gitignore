# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the example tracked, ignore real values)
.env*
!.env.example

# vercel
.vercel

# anteprima HTML del manuale (rigenerata da `npm run manuale -- --anteprima`)
docs/manuale/anteprima.html

# typescript
*.tsbuildinfo
next-env.d.ts

# worker di MapLibre (copiato da node_modules da `npm run prebuild`)
public/maplibre-gl-worker.mjs

.vercel
.env*
